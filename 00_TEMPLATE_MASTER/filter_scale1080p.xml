<?xml version="1.0" encoding="utf-8"?>
<!--ShanaEncoder-->
<!--FILTER REFERENCE: Scale to 1080p with bicubic, auto-pad, SAR reset. Not a standalone preset.-->
<!--Inject <filterparamBoxV> into a TransTo1080p preset. Combine with an encoding template.-->
<Settings>
  <filterparamBoxV> -vf "scale=1920:1080:flags=bicubic,shanapad=Auto,setsar=1/1,shanasubtitle=1"</filterparamBoxV>
  <!--scale_qsv alternative (for QSV hardware pipeline — test first):-->
  <!--<filterparamBoxV> -vf "scale_qsv=w=1920:h=1080,shanasubtitle=1"</filterparamBoxV>-->
</Settings>
